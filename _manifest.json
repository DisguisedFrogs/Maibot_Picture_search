{
  "manifest_version": 2,
  "version": "1.1.0",
  "name": "maibot-mood 心情插件",
  "description": "按群 LLM 分析聊天氛围心情（差/中/好）并持久化，供模型按心情从本地 Pixiv 榜库选图发图",
  "author": {
    "name": "DisguisedFrogs",
    "url": "https://github.com/DisguisedFrogs"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/DisguisedFrogs/Maibot_Picture_search",
    "homepage": "https://github.com/DisguisedFrogs/Maibot_Picture_search",
    "documentation": "https://github.com/DisguisedFrogs/Maibot_Picture_search/blob/main/README.md",
    "issues": "https://github.com/DisguisedFrogs/Maibot_Picture_search/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "llm.generate",
    "message.get_recent",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.DisguisedFrogs.maibot-mood"
}
